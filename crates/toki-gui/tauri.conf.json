{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toki",
  "version": "0.1.0",
  "identifier": "dev.achintya.toki",
  "build": {
    "beforeDevCommand": "bun --cwd=../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun --cwd=../ui run build",
    "frontendDist": "ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "Toki",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
